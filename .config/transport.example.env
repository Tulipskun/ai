# Discord transport
DISCORD_BOT_TOKEN=
# Single Discord user allowed to use bot interactions (Discord user ID)
DISCORD_OWNER_ID=

# CLI transport
AI_CLI_ENABLED=false

# AI runtime
AI_PROVIDER=
AI_MODEL=
AI_SYSTEM_PROMPT=
AI_MAX_OUTPUT_TOKENS=
AI_SESSION_DB=.data/sessions.db
AI_PROVIDER_CONFIG=.config/provider.json
AI_WORKSPACE=.

# When CLI is enabled, AI_MODEL is required and AI_PROVIDER may be omitted
# when exactly one provider is configured.

# Browser / web tools
# Browser automation is opt-in to preserve existing deployments.
AI_BROWSER_ENABLED=false
AI_BROWSER_HOST=127.0.0.1
AI_BROWSER_PORT=0
AI_BROWSER_NODE=node
AI_BROWSER_WORKER=browser/server.mjs
AI_BROWSER_WORKER_DIR=.
AI_BROWSER_HEADLESS=true
AI_BROWSER_IDLE_TIMEOUT=30m
AI_BROWSER_ALLOW_PRIVATE=false
AI_BROWSER_NAVIGATION_TIMEOUT=30s
AI_BROWSER_ACTION_TIMEOUT=10s
AI_BROWSER_SNAPSHOT_TIMEOUT=10s
AI_BROWSER_STARTUP_TIMEOUT=30s
